<?xml version="1.0" encoding="UTF-8"?>
<typeSystemDescription xmlns="http://uima.apache.org/resourceSpecifier">
    <name>EmotionTypeSystem</name>
    <description>
        Modell-agnostisches Emotions-Typesystem fuer multimodale Emotion Recognition.
        Deckt kategorial (volle Score-Verteilung) und dimensional (VAD) ab und
        funktioniert sowohl fuer Satz- als auch fuer Frame-Granularitaet.
        Modell-Herkunft per Verweis auf org.texttechnologylab.annotation.model.MetaData
        (TTLab-Standard, wird wiederverwendet statt dupliziert).
    </description>
    <version>1.1</version>
    <vendor>own</vendor>
    <imports>
        <import name="desc.type.TypeSystemModelMeta"/>
    </imports>

    <types>

        <!-- Ein Label/Score-Eintrag der Verteilung -->
        <typeDescription>
            <name>org.texttechnologylab.annotation.emotion.EmotionScore</name>
            <description>Ein Emotionslabel mit Score.</description>
            <supertypeName>uima.cas.TOP</supertypeName>
            <features>
                <featureDescription>
                    <name>label</name>
                    <description>Emotionsname, z.B. "joy", "anger", "neutral".</description>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>score</name>
                    <description>Score/Wahrscheinlichkeit, typisch 0.0 - 1.0.</description>
                    <rangeTypeName>uima.cas.Double</rangeTypeName>
                </featureDescription>
            </features>
        </typeDescription>

        <!-- Emotionsannotation (erbt von standard annot: also mit begin,end -->
        <typeDescription>
            <name>org.texttechnologylab.annotation.emotion.Emotion</name>
            <description>Emotion ueber einem Segment/Frame: Verteilung + optional VAD + Herkunft.</description>
            <supertypeName>uima.tcas.Annotation</supertypeName>
            <features>

                <!-- KATEGORIAL -->
                <featureDescription>
                    <name>scores</name>
                    <description>Volle Verteilung als EmotionScore-Liste.</description>
                    <rangeTypeName>uima.cas.FSArray</rangeTypeName>
                    <elementType>org.texttechnologylab.annotation.emotion.EmotionScore</elementType>
                </featureDescription>
                <featureDescription>
                    <name>dominant</name>
                    <description>Label mit hoechstem Score.</description>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>dominantScore</name>
                    <description>Score des dominanten Labels.</description>
                    <rangeTypeName>uima.cas.Double</rangeTypeName>
                </featureDescription>

                <!-- DIMENSIONAL (VAD), optional -->
                <featureDescription>
                    <name>valence</name>
                    <rangeTypeName>uima.cas.Double</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>arousal</name>
                    <rangeTypeName>uima.cas.Double</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>dominance</name>
                    <rangeTypeName>uima.cas.Double</rangeTypeName>
                </featureDescription>

                <!-- VERKNUEPFUNG: Verweis aufs Segment (Komfort/Anker bei Frames) -->
                <featureDescription>
                    <name>reference</name>
                    <description>Annotiertes Segment. Bei Satz-Granularitaet ein AudioSentence,
                        bei Frame-Granularitaet ein Image/SubImage (Gesichtscrop).</description>
                    <rangeTypeName>uima.tcas.Annotation</rangeTypeName>
                </featureDescription>

                <!-- ZEIT (multimodal), v.a. fuer Frame-Granularitaet -->
                <featureDescription>
                    <name>timeStart</name>
                    <description>Startzeit in Sekunden (optional).</description>
                    <rangeTypeName>uima.cas.Double</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>timeEnd</name>
                    <description>Endzeit in Sekunden (optional). Bei Einzelframe == timeStart.</description>
                    <rangeTypeName>uima.cas.Double</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>frameIndex</name>
                    <description>Optionaler Frame-Index (nur Zusatzinfo, nicht primaerer Schluessel).</description>
                    <rangeTypeName>uima.cas.Integer</rangeTypeName>
                </featureDescription>

                <!-- GRANULARITAET: explizite Unterscheidung Aggregat vs. Einzelframe -->
                <featureDescription>
                    <name>granularity</name>
                    <description>"sentence" = ueber einem Satz aggregiert,
                        "frame" = einzelne Frame-/Crop-Emotion. Erspart instanceof-Pruefungen
                        beim Auswerten und verhindert versehentliches Mitteln ueber Aggregate.</description>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>

                <!-- HERKUNFT DER AGGREGATION: welche Frame-Emotionen flossen ein -->
                <featureDescription>
                    <name>aggregatedFrom</name>
                    <description>Bei granularity="sentence": die Frame-Emotionen (granularity="frame"),
                        aus denen dieses Aggregat berechnet wurde. Macht die Aggregation
                        nachvollziehbar/reproduzierbar. Bei Frame-Emotionen leer/null.</description>
                    <rangeTypeName>uima.cas.FSArray</rangeTypeName>
                    <elementType>org.texttechnologylab.annotation.emotion.Emotion</elementType>
                    <multipleReferencesAllowed>true</multipleReferencesAllowed>
                </featureDescription>

                <!-- HERKUNFT -->
                <featureDescription>
                    <name>modality</name>
                    <description>"text" | "audio" | "video" | "fusion".</description>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>model</name>
                    <description>Verweis auf die (geteilte) Modell-MetaData.</description>
                    <rangeTypeName>org.texttechnologylab.annotation.model.MetaData</rangeTypeName>
                </featureDescription>

            </features>
        </typeDescription>

    </types>
</typeSystemDescription>
