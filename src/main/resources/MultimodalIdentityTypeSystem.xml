<?xml version="1.0" encoding="UTF-8"?>
<typeSystemDescription xmlns="http://uima.apache.org/resourceSpecifier">
    <name>MultimodalIdentityTypeSystem</name>
    <description>
        Identitaets- und Video-Segmentierungs-Typen fuer die multimodale Pipeline.

        Zwei Gruppen:
          (1) Identitaets-Entitaeten (Supertyp uima.cas.TOP, span-los):
              Person, VoiceIdentity, FaceIdentity. Diese existieren ueber das
              ganze Dokument hinweg und tragen eine dokumentlokal konstante ID.
          (2) Zeit-Spans (Supertyp org.texttechnologylab.annotation.type.MultimediaElement,
              erben begin/end + timeStart/timeEnd): Shot, VideoFrame, PersonTrack,
              FaceDetection, SpeakerSegment.

        Designprinzip fuer DB-Abbildung: jeder Typ wird genau eine Tabelle.
        Referenz-Features sind als Fremdschluessel gedacht; String-*Id-Features
        sind dokumentlokal stabile, menschenlesbare Schluessel unabhaengig von xmi:id.

        Hinweis: MultimediaElement kommt aus der TTLab-Dependency UIMATypeSystem
        (Descriptor desc/type/TextTechnologyMultimedia.xml). Den Import-Namen unten
        ggf. an die konkrete Dependency-Version anpassen.
    </description>
    <version>0.1</version>
    <vendor>own</vendor>

    <imports>
        <!-- liefert org.texttechnologylab.annotation.type.MultimediaElement (begin/end + timeStart/timeEnd) -->
        <import name="desc.type.TextTechnologyMultimedia"/>
    </imports>

    <types>

        <!-- ============================================================= -->
        <!-- (1) IDENTITAETS-ENTITAETEN  (span-los, Supertyp TOP)          -->
        <!-- ============================================================= -->

        <!-- Die uebergeordnete Person. Hub, auf den Voice/Face zeigen.
             Wird erst vom (spaeteren) Fusions-Schritt erzeugt. -->
        <typeDescription>
            <name>org.texttechnologylab.annotation.identity.Person</name>
            <description>Dokumentlokale Person-Entitaet (span-los). Aggregiert Stimme und Gesicht.</description>
            <supertypeName>uima.cas.TOP</supertypeName>
            <features>
                <featureDescription>
                    <name>personId</name>
                    <description>Dokumentlokal konstante, stabile ID, z.B. "P00". DB-Primaerschluessel-Kandidat.</description>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>label</name>
                    <description>Optionaler menschenlesbarer Name/Rolle (z.B. "Moderator").</description>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
            </features>
        </typeDescription>

        <!-- Stimm-Identitaet: Cluster aller Sprech-Abschnitte einer Stimme. -->
        <typeDescription>
            <name>org.texttechnologylab.annotation.identity.VoiceIdentity</name>
            <description>Audio-seitige Identitaet (span-los). Aus den Diarisierungs-Labels geclustert.</description>
            <supertypeName>uima.cas.TOP</supertypeName>
            <features>
                <featureDescription>
                    <name>voiceId</name>
                    <description>Dokumentlokal konstante ID, typischerweise das Diarisierungs-Label (z.B. "SPEAKER_00").</description>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>person</name>
                    <description>Fremdschluessel auf die fusionierte Person (nullable bis zur Fusion).</description>
                    <rangeTypeName>org.texttechnologylab.annotation.identity.Person</rangeTypeName>
                </featureDescription>
                <!-- optional; blaeht das XMI auf -> ggf. extern halten (siehe plan.md) -->
                <featureDescription>
                    <name>embedding</name>
                    <description>Optionales Sprecher-Embedding (d-vector). Optional, kann ausgelagert werden.</description>
                    <rangeTypeName>uima.cas.DoubleArray</rangeTypeName>
                </featureDescription>
            </features>
        </typeDescription>

        <!-- Gesichts-Identitaet: Cluster aller Auftritte eines Gesichts ueber den Clip. -->
        <typeDescription>
            <name>org.texttechnologylab.annotation.identity.FaceIdentity</name>
            <description>Video-seitige Identitaet (span-los). Aus den ArcFace-Embeddings ueber Tracklets geclustert.</description>
            <supertypeName>uima.cas.TOP</supertypeName>
            <features>
                <featureDescription>
                    <name>faceId</name>
                    <description>Dokumentlokal konstante ID, z.B. "F00".</description>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>person</name>
                    <description>Fremdschluessel auf die fusionierte Person (nullable bis zur Fusion).</description>
                    <rangeTypeName>org.texttechnologylab.annotation.identity.Person</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>embedding</name>
                    <description>Optionales Gesichts-Embedding (ArcFace, z.B. 512-dim). Optional, kann ausgelagert werden.</description>
                    <rangeTypeName>uima.cas.DoubleArray</rangeTypeName>
                </featureDescription>
            </features>
        </typeDescription>

        <!-- ============================================================= -->
        <!-- (2) ZEIT-SPANS  (Supertyp MultimediaElement)                   -->
        <!--     erben begin/end (Text/Index-Anker) + timeStart/timeEnd     -->
        <!-- ============================================================= -->

        <!-- Ein Kamera-Shot zwischen zwei harten Schnitten (SBD-Output). -->
        <typeDescription>
            <name>org.texttechnologylab.annotation.video.Shot</name>
            <description>Kamera-Einstellung zwischen zwei Schnitten. Primaerschluessel ist die Zeit, nicht begin/end.</description>
            <supertypeName>org.texttechnologylab.annotation.type.MultimediaElement</supertypeName>
            <features>
                <featureDescription>
                    <name>shotIndex</name>
                    <description>Laufender Index des Shots im Dokument (0-basiert).</description>
                    <rangeTypeName>uima.cas.Integer</rangeTypeName>
                </featureDescription>
            </features>
        </typeDescription>

        <!-- Ein Koerper-Tracklet innerhalb eines Shots (Detektor + Tracker). -->
        <typeDescription>
            <name>org.texttechnologylab.annotation.video.PersonTrack</name>
            <description>Koerper-Tracklet (zeitkontinuierlich) innerhalb eines Shots. Traegt die zeitliche Identitaet.</description>
            <supertypeName>org.texttechnologylab.annotation.type.MultimediaElement</supertypeName>
            <features>
                <featureDescription>
                    <name>trackId</name>
                    <description>Tracker-ID, shot-lokal konstant (z.B. ByteTrack-ID).</description>
                    <rangeTypeName>uima.cas.Integer</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>shot</name>
                    <description>Fremdschluessel auf den Shot, in dem dieses Tracklet liegt.</description>
                    <rangeTypeName>org.texttechnologylab.annotation.video.Shot</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>face</name>
                    <description>Fremdschluessel auf die clip-konstante FaceIdentity (nullable bis zum Clustering).</description>
                    <rangeTypeName>org.texttechnologylab.annotation.identity.FaceIdentity</rangeTypeName>
                </featureDescription>
            </features>
        </typeDescription>

        <!-- Eine einzelne Gesichts-Detektion in genau einem Frame. -->
        <typeDescription>
            <name>org.texttechnologylab.annotation.video.FaceDetection</name>
            <description>Gesichts-bbox in genau einem Frame. Feinste Granularitaet der Video-Seite (analog AudioToken).</description>
            <supertypeName>org.texttechnologylab.annotation.type.MultimediaElement</supertypeName>
            <features>
                <featureDescription>
                    <name>frameIndex</name>
                    <description>Frame-Index im Originalvideo (0-basiert). Bucket-/Sortier-Schluessel, NICHT eindeutig
                        (mehrere Detektionen je Frame). Zeit steht zusaetzlich in timeStart (geerbt).</description>
                    <rangeTypeName>uima.cas.Integer</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>track</name>
                    <description>Fremdschluessel auf das zugehoerige PersonTrack (nullable, falls nicht getrackt).</description>
                    <rangeTypeName>org.texttechnologylab.annotation.video.PersonTrack</rangeTypeName>
                </featureDescription>
                <!-- bbox normiert 0..1 (aufloesungsunabhaengig, frontend-freundlich) -->
                <featureDescription>
                    <name>x</name>
                    <description>Linke obere Ecke x, normiert 0..1.</description>
                    <rangeTypeName>uima.cas.Float</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>y</name>
                    <description>Linke obere Ecke y, normiert 0..1.</description>
                    <rangeTypeName>uima.cas.Float</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>width</name>
                    <description>Breite, normiert 0..1.</description>
                    <rangeTypeName>uima.cas.Float</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>height</name>
                    <description>Hoehe, normiert 0..1.</description>
                    <rangeTypeName>uima.cas.Float</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>detectionScore</name>
                    <description>Konfidenz des Detektors (optional).</description>
                    <rangeTypeName>uima.cas.Float</rangeTypeName>
                </featureDescription>
                <!-- 5 SCRFD-Landmarks, normiert 0..1 (analog bbox). Reihenfolge fix:
             linkes Auge, rechtes Auge, Nase, linker Mundwinkel, rechter Mundwinkel.
             Flach als 10 Werte: [x0,y0, x1,y1, x2,y2, x3,y3, x4,y4].
             Zweck: gezieltes Re-Embedding (Alignment) ohne erneute SCRFD-Detektion;
             ausserdem Quelle der Frontalitaets-Berechnung. -->
                <featureDescription>
                    <name>landmarks</name>
                    <description>5 SCRFD-Landmarks als flaches Array (10 Werte, x/y abwechselnd),
                        normiert 0..1 wie die bbox. Reihenfolge: L-Auge, R-Auge, Nase, L-Mund, R-Mund.</description>
                    <rangeTypeName>uima.cas.FloatArray</rangeTypeName>
                </featureDescription>
            </features>
        </typeDescription>


        <!-- Eine einzelne Koerper-Detektion in genau einem Frame (Pendant zu FaceDetection). -->
        <typeDescription>
            <name>org.texttechnologylab.annotation.video.PersonDetection</name>
            <description>Koerper-bbox in genau einem Frame. Bewegliche Box des PersonTrack pro Frame.</description>
            <supertypeName>org.texttechnologylab.annotation.type.MultimediaElement</supertypeName>
            <features>
                <featureDescription>
                    <name>frameIndex</name>
                    <description>Frame-Index (0-basiert). Bucket-/Sortier-Schluessel, NICHT eindeutig. Zeit in timeStart (geerbt).</description>
                    <rangeTypeName>uima.cas.Integer</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>track</name>
                    <description>Fremdschluessel auf das PersonTrack, dem diese Box gehoert (vom Tracker gesetzt).</description>
                    <rangeTypeName>org.texttechnologylab.annotation.video.PersonTrack</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>x</name>
                    <description>Linke obere Ecke x, normiert 0..1.</description>
                    <rangeTypeName>uima.cas.Float</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>y</name>
                    <description>Linke obere Ecke y, normiert 0..1.</description>
                    <rangeTypeName>uima.cas.Float</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>width</name>
                    <description>Breite, normiert 0..1.</description>
                    <rangeTypeName>uima.cas.Float</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>height</name>
                    <description>Hoehe, normiert 0..1.</description>
                    <rangeTypeName>uima.cas.Float</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>detectionScore</name>
                    <description>Konfidenz des Detektors (optional).</description>
                    <rangeTypeName>uima.cas.Float</rangeTypeName>
                </featureDescription>
            </features>
        </typeDescription>

        <!-- Audio-seitiges Sprecher-Segment: Lauf aufeinanderfolgender Tokens
             mit gleichem speakerId. Pendant zu PersonTrack, fuer Vollstaendigkeit
             der Personen-Ebene (gehoert strenggenommen in den Audio-Zweig). -->
        <typeDescription>
            <name>org.texttechnologylab.annotation.audio.SpeakerSegment</name>
            <description>Zusammenhaengender Sprech-Abschnitt eines Sprechers (aus DiarizedAudioToken-Laeufen).</description>
            <supertypeName>org.texttechnologylab.annotation.type.MultimediaElement</supertypeName>
            <features>
                <featureDescription>
                    <name>speakerId</name>
                    <description>Diarisierungs-Label dieses Abschnitts (z.B. "SPEAKER_00").</description>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>voice</name>
                    <description>Fremdschluessel auf die VoiceIdentity.</description>
                    <rangeTypeName>org.texttechnologylab.annotation.identity.VoiceIdentity</rangeTypeName>
                </featureDescription>
            </features>
        </typeDescription>

    </types>
</typeSystemDescription>
