# Keeps the build context small and avoids baking local state into the
# images. Both the importer and webapp images build from the stack root,
# so this applies to both.
.venv/
__pycache__/
*.pyc
.git/
.gitignore
.env
.pytest_cache/
tests/
docs/
sample-input/
README.md
*.md
build-all.sh
docker-compose.yml
