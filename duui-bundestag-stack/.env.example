# Copy to .env and adjust. Every value here is already the default --
# an empty .env (or none at all) runs the sample data out of the box.
#
#   cp .env.example .env
#
# Full explanation of every variable: README "Configuration reference".

# =====================================================================
# THE ONE YOU ACTUALLY NEED: where your .xmi files + videos already are
# =====================================================================
# Absolute path to the folder your DUUI pipeline writes into -- the .xmi
# files and the video files they reference, side by side. You do NOT
# have to move or copy anything: this folder is mounted READ-ONLY into
# the importer, exactly where it already is.
#
# Defaults to ./importer/sample-input (the small demo pair shipped here).
#DUUI_INPUT_DIR=/Users/you/pipeline-output

# Where the importer PUTS the videos it extracts, and where the webapp
# reads them from. A plain name = Docker-managed named volume (default,
# nothing to set up). An absolute host path = bind mount, if you'd
# rather have the video store as a normal folder you can browse/back up.
#DUUI_VIDEO_STORE=video_media
#DUUI_VIDEO_STORE=/Users/you/duui-videos

# =====================================================================
# Ports (change if these are taken on your machine)
# =====================================================================
#DUUI_WEBAPP_HOST_PORT=8010     # viewer at http://localhost:<this>
#DUUI_DB_HOST_PORT=5432         # set this if you run a local Postgres too

# =====================================================================
# Database credentials (compose passes these to all three containers)
# =====================================================================
#DUUI_DB_NAME=duui_bundestag
#DUUI_DB_USER=duui
#DUUI_DB_PASSWORD=duui

# =====================================================================
# Optional: natural-language "Ask" panel in the viewer
# =====================================================================
# Any OpenAI-compatible chat-completions endpoint. Leave the key empty
# and the panel is simply disabled -- everything else works unchanged.
#DUUI_QUERY_API_KEY=
#DUUI_QUERY_BASE_URL=https://lehre.llm.texttechnologylab.org/api
#DUUI_QUERY_MODEL=gondor.qwen3-vl:32b

# =====================================================================
# Optional: post-processing step run during import
# =====================================================================
#DUUI_ENABLE_GLOBAL_PERSON_LINKING=true   # cross-video person identity

# =====================================================================
# Only relevant when running tests / main.py directly on the host
# (not in Docker) -- see README "Tests"
# =====================================================================
#DUUI_DB_HOST=localhost
