tion2:Emotion xmi:id="5748" sofa="1" begin="1318" end="1422" Emotions="5750 5751 5752 5753 5754 5755 5756 5757 5758 5759 5760 5761 5762 5747 5763 5764 5765 5766 5767 5768 5769 5770 5771 5772 5773 5774 5775 5776" model="5596"/><annotation2:Emotion xmi:id="5628" sofa="1" begin="1423" end="1538" Emotions="5630 5631 5632 5633 5634 5635 5636 5637 5638 5639 5640 5641 5642 5643 5644 5645 5646 5627 5647 5648 5649 5650 5651 5652 5653 5654 5655 5656" model="5596"/><annotation2:Emotion xmi:id="6108" sofa="1" begin="1539" end="1797" Emotions="6110 6111 6112 6113 6114 6115 6116 6117 6118 6119 6120 6121 6122 6123 6124 6125 6126 6127 6128 6129 6130 6131 6132 6133 6134 6107 6135 6136" model="5596"/><annotation2:Emotion xmi:id="6138" sofa="1" begin="1798" end="1911" Emotions="6140 6141 6142 6143 6144 6145 6146 6147 6148 6149 6150 6151 6152 6153 6154 6155 6156 6157 6137 6158 6159 6160 6161 6162 6163 6164 6165 6166" model="5596"/><annotation2:Emotion xmi:id="6018" sofa="1" begin="1912" end="2031" Emotions="6020 6021 6022 6023 6024 6025 6026 6027 6028 6029 6030 6031 6032 6033 6034 6035 6036 6037 6038 6039 6040 6041 6042 6043 6044 6045 6046 6017" model="5596"/><annotation2:Emotion xmi:id="5778" sofa="1" begin="2032" end="2129" Emotions="5780 5781 5782 5783 5784 5785 5786 5787 5788 5789 5790 5791 5792 5793 5794 5795 5796 5797 5798 5799 5800 5801 5802 5777 5803 5804 5805 5806" model="5596"/><annotation2:Emotion xmi:id="5658" sofa="1" begin="2130" end="2307" Emotions="5660 5661 5662 5663 5664 5665 5666 5667 5657 5668 5669 5670 5671 5672 5673 5674 5675 5676 5677 5678 5679 5680 5681 5682 5683 5684 5685 5686" model="5596"/><annotation2:Emotion xmi:id="5988" sofa="1" begin="2308" end="2437" Emotions="5990 5991 5992 5993 5994 5995 5996 5997 5998 5999 6000 6001 6002 6003 6004 6005 5987 6006 6007 6008 6009 6010 6011 6012 6013 6014 6015 6016" model="5596"/><annotation2:Emotion xmi:id="5868" sofa="1" begin="2438" end="2485" Emotions="5870 5871 5872 5873 5874 5875 5876 5877 5878 5879 5880 5881 5882 5883 5884 5885 5886 5887 5867 5888 5889 5890 5891 5892 5893 5894 5895 5896" model="5596"/><annotation2:Emotion xmi:id="6048" sofa="1" begin="2486" end="2534" Emotions="6050 6051 6052 6053 6054 6055 6056 6057 6058 6059 6060 6061 6062 6063 6064 6065 6066 6047 6067 6068 6069 6070 6071 6072 6073 6074 6075 6076" model="5596"/><annotation2:Emotion xmi:id="5928" sofa="1" begin="2535" end="2654" Emotions="5930 5931 5932 5933 5934 5935 5936 5937 5927 5938 5939 5940 5941 5942 5943 5944 5945 5946 5947 5948 5949 5950 5951 5952 5953 5954 5955 5956" model="5596"/><annotation2:Emotion xmi:id="5838" sofa="1" begin="2655" end="2667" Emotions="5840 5841 5842 5843 5844 5845 5846 5847 5848 5849 5850 5851 5852 5853 5854 5855 5837 5856 5857 5858 5859 5860 5861 5862 5863 5864 5865 5866" model="5596"/><cas:Sofa xmi:id="1" sofaNum="2" sofaID="transcriptView" mimeType="text/plain" sofaString="Sehr geehrte Frau Präsidentin, sehr geehrte Damen und Herren, sehr geehrte Kolleginnen und Kollegen, seit mehr als einem Jahr greift die Houthi-Miliz im Jemen gezielt internationale Handelsschiffe im Roten Meer an. Sie tun das aus vermeintlicher Solidarität mit den Palästinenserinnen und Palästinensern, nachdem die Hamas Israel am 7. Oktober brutal angegriffen hat und damit Krieg Not, Elend über Gaza gebracht hat, aber auch, um sich im innerhemenitischen Konflikt zu profilieren. Der Auftrag von Aspides ist der Schutz der Handelsschiffe im Roten Meer. Deutschland ist als Exportnation auf freie und sichere Handelswege und Seewege besonders angewiesen. Aspides trägt maßgeblich dazu bei und bleibt weiterhin eine wichtige Mission. An dieser Stelle möchte ich natürlich auch meinen expliziten Dank aussprechen an alle die deutschen Soldatinnen und Soldaten, die in unterschiedlichster Funktion an dieser Mission beteiligt sind und unter teils äußerst gefährlichen Bedingungen erfolgreich ihren Auftrag erfüllen. Die Hunkis werden unterstützt, ausgerüstet und handeln mindestens im Interesse des Irans. Berichte legen nahe, dass auch die Zusammenarbeit zwischen den Houthis und Russland zunimmt. Jemenitische Söldner werden an die Front in der Ukraine geschickt. Russland liefert im Gegenzug Waffen an die Houthis. Die Houthis spielen in dieser unheilvollen Achse Moskau, Teheran, Peking, Pyongyang eine wichtige Rolle. Und diese Achse dürfte nach der Niederlage der Hezbollah und dem Machtwechsel in Syrien noch an Bedeutung zunehmen. Meine Damen und Herren, Aspides ist damit nicht nur eine erfolgreiche Marine-Mission, sondern auch ein Ausweis erfolgreicher europäischer Zusammenarbeit in der Sicherheitspolitik, die dem globalen Bedrohungsnetzwerk aus Russland und Iran etwas entgegensetzt. Und genau deshalb ist es so wichtig, dass wir diesen Ansatz weiterverfolgen und diese Mission deshalb verlängern. Neben militärischen Mitteln bedarf es eines umfassenden EU-Ansatzes für Stabilität in der Region rund um das Rote Meer. Militär allein reicht nicht, um der Destabilisierungsstrategie Teherans oder Moskaus zu begegnen. Die Zusammenarbeit mit allen Anrainerstaaten sollte auf ein nachhaltiges Engagement, logischerweise zur Befriedung der Konflikte im Jemen, im Sudan oder auch im Nahost abziehen. Wo wir uns zurückziehen... also wo wir uns zurückziehen, so muss ich es sogar betonen, füllen Iran, Russland und China die Lücke. Europa hat mit Aspides eine Antwort formuliert. Lassen Sie uns diese gemeinsam heute fortführen. Es ist dringend notwendig, und ich rate meiner Fraktion dringend, diese Mission mit zu verlängern und dafür zu stimmen. Vielen Dank."/><cas:Sofa xmi:id="6257" sofaNum="1" sofaID="_InitialView"/><emotion:EmotionScore xmi:id="12840" label="Anger" score="0.1732877939939499"/><emotion:EmotionScore xmi:id="12841" label="Contempt" score="0.08847584575414658"/><emotion:EmotionScore xmi:id="12842" label="Disgust" score="0.06141988933086395"/><emotion:EmotionScore xmi:id="12843" label="Fear" score="0.014103567227721214"/><emotion:EmotionScore xmi:id="12844" label="Happiness" score="0.012