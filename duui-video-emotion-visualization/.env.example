# Copy to .env and uncomment what you need. Every line here is already
# the effective default, so an empty .env — or none at all — runs the
# shipped sample.
#
#     cp .env.example .env
#
# One line per variable. What each one means in full, and which layer
# reads it, is in docs/configuration.md.
#
# Six are marked "Compose does not pass this through". They work for a
# run outside Docker and for the test runner, both of which read this
# file directly. They do NOT reach the three containers `docker compose
# up` starts, because docker-compose.yml never names them; changing one
# of those means editing that file. See docs/configuration.md, "What
# .env can and cannot change".


# --- Where your material is ---------------------------------------------
# The two settings a first run with real data needs. Both are mounted
# read-only, so nothing is moved or modified where it already lives.

# Directory of .xmi files. Unset, the sample inside the importer image.
#DUUI_INPUT_XMI_DIR=/absolute/path/to/xmi

# Directory of the videos those files name. Unset, it follows
# DUUI_INPUT_XMI_DIR — set it only when the videos live elsewhere.
#DUUI_INPUT_VIDEO_DIR=/absolute/path/to/videos

# A single file to import when the command line names no path. Compose
# does not pass this through, and it is under review: the command line
# already takes any mix of files and directories. See docs/todo.md.
#DUUI_XMI_FILE=

# The video store: where the importer puts videos and the webapp reads
# them. Compose does not pass this through: it pins the container path
# below, and DUUI_VIDEO_STORE decides what is mounted onto it.
#DUUI_VIDEO_DIR=/data/videos


# --- Database -----------------------------------------------------------
# Read by all three sub-projects, which is how one value reaches three
# containers that share no code.

#DUUI_DB_NAME=duui_video_emotion
#DUUI_DB_USER=duui
#DUUI_DB_PASSWORD=duui

# Compose does not pass this through: it pins the database service's
# name. Only a run outside Docker uses this value.
#DUUI_DB_HOST=localhost

# Seconds to wait for the connection itself, never for a query.
#DUUI_DB_CONNECT_TIMEOUT=10


# --- Importer -----------------------------------------------------------

# What to do with a CAS whose video is already imported: `skip` leaves
# it alone without loading the file, `replace` rebuilds its rows.
#DUUI_ON_EXISTING=skip

# Which sofa holds the video, for a CAS carrying one embedded.
#DUUI_VIDEO_VIEW=_InitialView

# Typesystem descriptors. The bundled ones match the pipeline version
# the image was built for; override only to read a CAS from another.
# Compose does not pass these three through.
#DUUI_TS_IDENTITY_EMOTION=
#DUUI_TS_MULTIMODAL_IDENTITY=
#DUUI_TS_EMOTION=


# --- Identity linking ---------------------------------------------------
# Cosine distances at which two people from different videos count as
# the same person. Lower is stricter. No derivation for either default
# is recorded in this repository — retune them against duplicates you
# already know about in your own material.

#DUUI_GLOBAL_PERSON_FACE_DISTANCE_THRESHOLD=0.30
#DUUI_GLOBAL_PERSON_VOICE_DISTANCE_THRESHOLD=0.35


# --- Webapp: the Ask panel ----------------------------------------------
# Any OpenAI-compatible chat-completions endpoint. Leave the key empty
# and the panel reports itself as unconfigured; everything else works.

#DUUI_QUERY_API_KEY=
#DUUI_QUERY_BASE_URL=https://lehre.llm.texttechnologylab.org/api
#DUUI_QUERY_MODEL=gondor.qwen3-vl:32b

# Row cap on a query the model writes.
#DUUI_QUERY_MAX_ROWS=500

# How long one of those queries may run, in milliseconds.
#DUUI_QUERY_STATEMENT_TIMEOUT_MS=8000

# How many turns the model gets before the attempt is abandoned.
#DUUI_QUERY_MAX_TOOL_ITERATIONS=6


# --- Read by Compose only -----------------------------------------------
# Not in the source. Setting these for a run outside Docker does
# nothing.

# Host port the webapp is published on. Always 8000 in the container.
#DUUI_WEBAPP_HOST_PORT=8010

# Host port the database is published on.
#DUUI_DB_HOST_PORT=5432

# What gets mounted as the video store. Either the literal name
# `video_media`, the volume docker-compose.yml declares, or a path —
# absolute, or relative starting `./` — for a bind mount you can browse
# and back up. Any other bare name fails as an undefined volume.
#DUUI_VIDEO_STORE=video_media

# The database the test runner creates and uses, kept separate so a test
# run cannot touch real data.
#DUUI_TEST_DB_NAME=duui_video_emotion_test

# The uid and gid the test container runs as, so files it writes belong
# to you.
#DUUI_TEST_UID=1000
#DUUI_TEST_GID=1000
