{
  // Applies to every .md file. Legacy documents are excluded below: they are
  // deleted when Phase 7 finishes and reformatting them would put churn in a
  // diff that should stay empty.
  "globs": [
    "**/*.md",
    "!docs/legacy/**",
    "!node_modules/**",
    // Captured output from a past accessibility run, not documents under
    // maintenance. Reformatting a record of what a tool printed would falsify
    // it. The README beside them is linted, because it carries live
    // instructions.
    "!webapp/docs/a11y-baseline/axe-baseline.md",
    "!webapp/docs/a11y-baseline/keyboard-sweep.md"
  ],
  "config": {
    "default": true,
    // 80 columns for prose, per docs/documentation-style.md section 8. Tables,
    // code blocks and long link targets cannot be wrapped without breaking them.
    "MD013": {
      "line_length": 80,
      "tables": false,
      "code_blocks": false
    },
    // This project writes *emphasis* with asterisks throughout.
    "MD049": { "style": "asterisk" },
    "MD050": { "style": "asterisk" },
    // Duplicate headings are fine when they sit under different parents -- the
    // phase plans repeat "Exit criteria" and similar by design.
    "MD024": { "siblings_only": true },
    // Inline HTML is used deliberately: <!-- --> notes in the stub documents and
    // the occasional <br> in a table cell.
    "MD033": false
  }
}
