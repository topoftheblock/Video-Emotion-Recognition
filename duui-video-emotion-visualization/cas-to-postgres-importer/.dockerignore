# Keeps the build context small and local state out of the image. The
# build context is this directory, so every path below is relative to
# it.
__pycache__/
*.pyc
.pytest_cache/
tests/
pyproject.toml
# The demo CAS and its video: Compose bind-mounts these as the default
# input instead, so they never need to be in the image.
src/resources/sample-input/
*.md
Dockerfile
