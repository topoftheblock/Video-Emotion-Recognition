<?xml version="1.0" encoding="UTF-8"?>
<typeSystemDescription xmlns="http://uima.apache.org/resourceSpecifier">
    <name>DUUI_Emotion_TypeSystem</name>
    <types>
        <!-- EmotionScore -->
        <typeDescription>
            <name>org.texttechnologylab.annotation.emotion.EmotionScore</name>
            <supertypeName>uima.cas.TOP</supertypeName>
            <features>
                <featureDescription>
                    <name>label</name>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>score</name>
                    <rangeTypeName>uima.cas.Double</rangeTypeName>
                </featureDescription>
            </features>
        </typeDescription>

        <!-- Emotion -->
        <typeDescription>
            <name>org.texttechnologylab.annotation.emotion.Emotion</name>
            <supertypeName>uima.tcas.Annotation</supertypeName>
            <features>
                <featureDescription>
                    <name>scores</name>
                    <rangeTypeName>uima.cas.FSArray</rangeTypeName>
                    <elementType>org.texttechnologylab.annotation.emotion.EmotionScore</elementType>
                </featureDescription>
                <featureDescription>
                    <name>dominant</name>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>dominantScore</name>
                    <rangeTypeName>uima.cas.Double</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>valence</name>
                    <rangeTypeName>uima.cas.Double</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>arousal</name>
                    <rangeTypeName>uima.cas.Double</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>dominance</name>
                    <rangeTypeName>uima.cas.Double</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>reference</name>
                    <rangeTypeName>uima.tcas.Annotation</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>timeStart</name>
                    <rangeTypeName>uima.cas.Double</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>timeEnd</name>
                    <rangeTypeName>uima.cas.Double</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>frameIndex</name>
                    <rangeTypeName>uima.cas.Integer</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>granularity</name>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>aggregatedFrom</name>
                    <rangeTypeName>uima.cas.FSArray</rangeTypeName>
                    <elementType>org.texttechnologylab.annotation.emotion.Emotion</elementType>
                    <multipleReferencesAllowed>true</multipleReferencesAllowed>
                </featureDescription>
                <featureDescription>
                    <name>modality</name>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>model</name>
                    <rangeTypeName>org.texttechnologylab.annotation.model.MetaData</rangeTypeName>
                </featureDescription>
            </features>
        </typeDescription>

        <!-- MetaData -->
        <typeDescription>
            <name>org.texttechnologylab.annotation.model.MetaData</name>
            <supertypeName>uima.cas.AnnotationBase</supertypeName>
            <features>
                <featureDescription>
                    <name>reference</name>
                    <rangeTypeName>uima.cas.TOP</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>name</name>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>version</name>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>modelName</name>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>modelVersion</name>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
            </features>
        </typeDescription>

        <!-- DocumentModification -->
        <typeDescription>
            <name>org.texttechnologylab.annotation.DocumentModification</name>
            <supertypeName>uima.cas.AnnotationBase</supertypeName>
            <features>
                <featureDescription>
                    <name>user</name>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>timestamp</name>
                    <rangeTypeName>uima.cas.Long</rangeTypeName>
                </featureDescription>
                <featureDescription>
                    <name>comment</name>
                    <rangeTypeName>uima.cas.String</rangeTypeName>
                </featureDescription>
            </features>
        </typeDescription>
    </types>
</typeSystemDescription>
