# Copy this file to .env and fill in your real values.
# .env itself should never be committed (see .gitignore).
#
# Full explanation of every variable: README "Configuration reference".
# Every value shown here is already the default -- an empty .env works.

# =====================================================================
# Docker Compose only (read on the HOST to build the compose file)
# =====================================================================

# --- Ports (change if these are already taken on your machine) ---
# DUUI_WEBAPP_HOST_PORT=8010    # viewer at http://localhost:<this>
# DUUI_DB_HOST_PORT=5432        # set this if you run a local Postgres too

# --- Where files live on the host ---
# Directory your pipeline writes into: CAS .xmi files, each next to the
# video file it references.
# DUUI_INPUT_HOST_DIR=./cas
# DUUI_TYPESYSTEMS_HOST_DIR=./typesystems
# Where imported videos are kept. A plain name = Docker named volume;
# a host path (e.g. /srv/duui-videos) = bind mount, if you want to
# browse or back up the video store directly.
# DUUI_VIDEO_STORE=video_media

# =====================================================================
# Application settings (used by main.py / the webapp, in or out of Docker)
# docker-compose.yml already sets the container-side values for these.
# =====================================================================

# --- Input / output directories ---
# Directory the importer READS (.xmi + videos). A no-argument
# `python main.py` imports every .xmi in here.
DUUI_INPUT_DIR=cas
# Directory the importer WRITES videos into and the webapp SERVES from,
# keyed by each row's videos.filename (e.g. cas/first2.mp4). The DB
# never stores video bytes.
DUUI_VIDEO_DIR=cas
# Optional: import just this one file when no path is passed, instead
# of all of DUUI_INPUT_DIR. Leave unset for the batch default.
# DUUI_XMI_FILE=cas/full_2sek_with_person.xmi

DUUI_TS_IDENTITY_EMOTION=typesystems/IdentityEmotionTypeSystem.xml
DUUI_TS_MULTIMODAL_IDENTITY=typesystems/MultimodalIdentityTypeSystem.xml
DUUI_TS_EMOTION=typesystems/EmotionTypeSystem.xml

# --- Database ---
# docker-compose sets these for its containers (with DUUI_DB_HOST=db,
# the service name). The values here only matter when running main.py
# directly on the host against a local or containerized Postgres.
DUUI_DB_NAME=duui_bundestag
DUUI_DB_USER=duui
DUUI_DB_PASSWORD=duui
DUUI_DB_HOST=localhost

# --- Natural-language query agent (webapp "Ask" panel) ---
# Any OpenAI-compatible chat-completions endpoint. This project was
# built against a university-hosted Open WebUI/Ollama gateway serving
# Qwen3-VL -- swap base URL/model for a different provider if needed.
# Leave DUUI_QUERY_API_KEY empty to disable the "Ask" panel entirely;
# everything else in the app works without it.
DUUI_QUERY_API_KEY=
DUUI_QUERY_BASE_URL=https://lehre.llm.texttechnologylab.org/api
DUUI_QUERY_MODEL=gondor.qwen3-vl:32b
# DUUI_QUERY_MAX_ROWS=500
# DUUI_QUERY_STATEMENT_TIMEOUT_MS=8000
# DUUI_QUERY_MAX_TOOL_ITERATIONS=6

# --- Post-processing steps (see README "Post-processing") ---
# Uncomment to override the defaults shown.
# DUUI_ENABLE_GLOBAL_PERSON_LINKING=true
# DUUI_GLOBAL_PERSON_FACE_DISTANCE_THRESHOLD=0.30
# DUUI_GLOBAL_PERSON_VOICE_DISTANCE_THRESHOLD=0.35
# DUUI_ENABLE_EMOTION_FUSION=true
# DUUI_ENABLE_NLP_ENRICHMENT=false
# DUUI_SPACY_MODEL=de_core_news_sm
